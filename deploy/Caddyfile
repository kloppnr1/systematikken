# Caddy gets and renews the HTTPS certificates on its own.
(headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# The front page. Only the page itself and its files are served here; every other address
# goes to the app, so old links like systematikken.dk/login still work.
{$SITE_DOMAIN} {
	import headers
	@app not path / /assets/* /favicon.svg /favicon-32.png /apple-touch-icon.png /api/stats/hit
	redir @app https://{$DOMAIN}{uri}
	reverse_proxy app:8080
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# The app.
{$DOMAIN} {
	import headers
	reverse_proxy app:8080
}

# The demo with made-up data.
{$DEMO_DOMAIN} {
	import headers
	header X-Robots-Tag "noindex"
	reverse_proxy demo:8080
}
