# Copy to /opt/systematikken/.env on the server and fill in. Never commit the real file.

# The front page, e.g. systematikken.dk. www. redirects to it.
SITE_DOMAIN=systematikken.dk

# The app, e.g. app.systematikken.dk. Caddy gets the certificate for it.
DOMAIN=

# Who may see visits and clicks on /tal, separated by commas. Defaults to martin@kloppconsulting.dk.
OPERATOR_EMAILS=

# The demo with made-up data, e.g. demo.systematikken.dk.
DEMO_DOMAIN=

# Google login: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<DOMAIN>/signin-google
Auth__Google__ClientId=
Auth__Google__ClientSecret=

# Microsoft login: https://entra.microsoft.com > App registrations, "Personal and work accounts"
# Redirect URI: https://<DOMAIN>/signin-microsoft
# The secret expires after at most 24 months. Renew it before then.
Auth__Microsoft__ClientId=
Auth__Microsoft__ClientSecret=
